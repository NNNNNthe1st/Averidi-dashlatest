# Dashboard-only restricted runtime principal. Never use the migration/owner principal.
DASHBOARD_DATABASE_URL=
DASHBOARD_MONITOR_READY_URL=https://dashboard-staging.example.invalid/dashboard/app/api/health/ready
DASHBOARD_MONITOR_STATE_DIRECTORY=/var/lib/averidi-dashboard-monitor
# Independent storage configuration, copied from this environment's Dashboard configuration.
DASHBOARD_STORAGE_BACKEND=local
DASHBOARD_STORAGE_ROOT=
# For object storage, supply the dedicated object endpoint/bucket/region/key configuration instead.
DASHBOARD_MONITOR_WEBHOOK_URL=
DASHBOARD_MONITOR_WEBHOOK_TOKEN=
# Reliability thresholds, not customer business policies.
DASHBOARD_MONITOR_FAILURE_SAMPLES=2
DASHBOARD_MONITOR_RECOVERY_SAMPLES=2
DASHBOARD_MONITOR_REMINDER_SECONDS=1800
DASHBOARD_MONITOR_WINDOW_SECONDS=900
DASHBOARD_MONITOR_QUEUE_SECONDS=300
DASHBOARD_MONITOR_FAILED_JOBS=1
DASHBOARD_MONITOR_EXPIRED_LEASES=1
DASHBOARD_MONITOR_OPERATIONAL_ERRORS=1
DASHBOARD_MONITOR_REFRESH_FAILURES=1
DASHBOARD_MONITOR_METRIC_FAILURES=1
DASHBOARD_MONITOR_REQUEST_ERRORS=1
DASHBOARD_MONITOR_REQUEST_MAX_MS=15000
DASHBOARD_MONITOR_CPU_LOAD_PER_CORE=2
DASHBOARD_MONITOR_MEMORY_PERCENT=95
DASHBOARD_MONITOR_DISK_PERCENT=90
# Optional separate-host watchdog. Set both together; endpoint must terminate TLS.
DASHBOARD_MONITOR_HEARTBEAT_URL=
DASHBOARD_MONITOR_HEARTBEAT_TOKEN=

DASHBOARD_MONITOR_JOB_MAX_MS=600000
