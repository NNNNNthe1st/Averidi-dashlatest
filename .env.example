# ONLY for the independent Dashboard app. Never point at the website/Analyst DB.
DASHBOARD_DATABASE_URL=postgresql://dashboard:local-dashboard-only@127.0.0.1:5434/dashboard_dev?schema=public
DASHBOARD_STORAGE_ROOT=./.local/dashboard-storage
# Item 1: opt-in immutable Parquet + DuckDB frames; set on both web and worker after acceptance.
DASHBOARD_COLUMNAR_ENGINE=disabled
# Cross-product integrations and SSO remain inactive.
DASHBOARD_EXTERNAL_INTEGRATIONS_ENABLED=false

# Optional future verified OIDC bearer-token integration. Leave unset until configured.
# DASHBOARD_OIDC_ISSUER=https://identity.example.com/
# DASHBOARD_OIDC_AUDIENCE=averidi-dashboard
# DASHBOARD_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Enable only in a separate worker process using isolated Dashboard development resources.
DASHBOARD_WORKER_ENABLED=false

# Required for signed browser sessions; use a unique secret of at least 32 bytes.
# DASHBOARD_SESSION_SECRET=

# Deployment does not enable Dashboard access. OFF / BETA / GENERAL.
DASHBOARD_RELEASE_MODE=OFF
# Only used when DASHBOARD_RELEASE_MODE=BETA; comma-separated Dashboard workspace IDs.
DASHBOARD_BETA_WORKSPACE_IDS=

# Change to invalidate all signed Dashboard browser sessions.
DASHBOARD_SESSION_VERSION=1

# To enable standalone browser login, configure a registered OIDC public client.
# The client must allow authorization-code + PKCE (S256), with no client secret.
# DASHBOARD_OIDC_CLIENT_ID=dashboard-client-id
# DASHBOARD_OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
# DASHBOARD_OIDC_TOKEN_URL=https://identity.example.com/oauth/token
# DASHBOARD_OIDC_REDIRECT_URL=https://dashboard.example.com/dashboard/app/api/auth/callback
# OIDC issuer, JWKS URL and client audience must be configured above as well.
# Browser login is unavailable until real issuer endpoints and client registration exist.
DASHBOARD_SESSION_VERSION=1

# Item 6: optional central administration API identity provider.
# The website admin app must obtain a separately signed admin JWT via a trusted issuer.
# Dashboard rejects all admin API access while this configuration is missing.
# DASHBOARD_ADMIN_OIDC_ISSUER=https://identity.example.com/
# DASHBOARD_ADMIN_OIDC_AUDIENCE=averidi-dashboard-admin
# DASHBOARD_ADMIN_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Item 9: standalone Dashboard storage backend (default local; remote requires unique credentials).
DASHBOARD_STORAGE_BACKEND=local
# DASHBOARD_OBJECT_ENDPOINT=https://dashboard-object-endpoint.example.com
# DASHBOARD_OBJECT_BUCKET=dashboard-private-bucket
# DASHBOARD_OBJECT_REGION=us-east-1
# DASHBOARD_OBJECT_ACCESS_KEY_ID=
# DASHBOARD_OBJECT_SECRET_ACCESS_KEY=
# Never reuse website or Analyst storage resources or credentials.

# Dashboard-only HTTPS origin for cookie mutation/CSRF checks.
# DASHBOARD_PUBLIC_ORIGIN=https://localhost:8443
# A separate Node process runs the background worker; defaults stay disabled.
DASHBOARD_WORKER_POLL_MS=1000

# Optional separate schema owner used only by db:deploy and db:grant.
# Never provide this owner credential to the web or worker process.
# DASHBOARD_MIGRATION_DATABASE_URL=postgresql://dashboard:local-dashboard-only@127.0.0.1:5434/dashboard_dev?schema=public
# After provisioning a non-owner role, set DASHBOARD_DATABASE_URL to that role and run db:grant.

# Upper bound for one worker attempt (1000–1800000 ms); default 10 minutes.
DASHBOARD_WORKER_JOB_TIMEOUT_MS=600000

# External business data connectors (separate from inactive Averidi cross-product contracts).
DASHBOARD_DATA_CONNECTORS_ENABLED=false
# Dedicated 32-byte hex encryption key; never reuse another application's key.
# DASHBOARD_CONNECTOR_ENCRYPTION_KEY=
# Register Dashboard-only OAuth applications and set each enabled provider's pair:
# DASHBOARD_CONNECTOR_GOOGLE_SHEETS_CLIENT_ID=
# DASHBOARD_CONNECTOR_GOOGLE_SHEETS_CLIENT_SECRET=
# DASHBOARD_CONNECTOR_SHOPIFY_CLIENT_ID=
# DASHBOARD_CONNECTOR_SHOPIFY_CLIENT_SECRET=
# DASHBOARD_CONNECTOR_STRIPE_CLIENT_ID=
# DASHBOARD_CONNECTOR_STRIPE_CLIENT_SECRET= # Stripe platform secret API key
# DASHBOARD_CONNECTOR_QUICKBOOKS_CLIENT_ID=
# DASHBOARD_CONNECTOR_QUICKBOOKS_CLIENT_SECRET=
# DASHBOARD_CONNECTOR_HUBSPOT_CLIENT_ID=
# DASHBOARD_CONNECTOR_HUBSPOT_CLIENT_SECRET=
# DASHBOARD_CONNECTOR_SQUARE_CLIENT_ID=
# DASHBOARD_CONNECTOR_SQUARE_CLIENT_SECRET=
# DASHBOARD_CONNECTOR_XERO_CLIENT_ID=
# DASHBOARD_CONNECTOR_XERO_CLIENT_SECRET=
# Operator-approved HTTPS origins, comma-separated; never accept arbitrary customer URLs.
# DASHBOARD_CONNECTOR_WOOCOMMERCE_ORIGINS=https://approved-store.example.com

# Storage backups are authenticated/encrypted with a separate 32-byte hex key.
# Keep this key outside the backup directory; retain it for recovery.
# DASHBOARD_STORAGE_BACKUP_KEY=
# Retention is configured per workspace by an OWNER through /storage/policy.
# No inactive-version or archived-dataset expiry is enabled by default.

# Dashboard's OWN subscriptions; independent of Stripe data-source connectors.
DASHBOARD_BILLING_ENABLED=false
DASHBOARD_BILLING_STRIPE_MODE=test
DASHBOARD_BILLING_STRIPE_SECRET_KEY=
DASHBOARD_BILLING_STRIPE_WEBHOOK_SECRET=
# Never copy website, Analyst or data-connector credentials into these values.

# Future Averidi ecosystem contract only. The source-level integration lock remains false.
# Setting these values or the existing external-integration flag does NOT activate connections.
# Dedicated short-lived, purpose-bound identity-provider access tokens; never website cookies.
# DASHBOARD_ECOSYSTEM_OIDC_ISSUER=https://identity.example.com/
# DASHBOARD_ECOSYSTEM_OIDC_AUDIENCE=averidi-dashboard-ecosystem-v1
# DASHBOARD_ECOSYSTEM_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Shared PostgreSQL API/login budgets (requests per fixed UTC minute, 1–100000).
DASHBOARD_RATE_LIMIT_API_PER_MINUTE=600
DASHBOARD_RATE_LIMIT_AUTH_PER_MINUTE=30
# Default: forwarded/client-IP headers are ignored; unattributed clients share a budget.
# Only set BOTH after an exclusive trusted ingress overwrites this header and blocks direct web access:
# DASHBOARD_RATE_LIMIT_TRUST_PROXY=true
# DASHBOARD_RATE_LIMIT_IP_HEADER=x-dashboard-client-ip

# Dashboard-owned customer checkout and portal; keep OFF until test-mode acceptance.
DASHBOARD_BILLING_SELF_SERVICE_ENABLED=false
# Explicit dedicated-account portal configuration with approved Dashboard plan prices only.
DASHBOARD_BILLING_PORTAL_CONFIGURATION=

# Account erasure is inactive until dedicated configuration and retention policy are reviewed.
DASHBOARD_ACCOUNT_ERASURE_ENABLED=false
DASHBOARD_ACCOUNT_ERASURE_KEY=
DASHBOARD_ACCOUNT_ERASURE_LEDGER_ROOT=
# Explicit approved days; absence blocks owned workspaces with financial history.
DASHBOARD_ACCOUNT_ERASURE_FINANCIAL_RETENTION_DAYS=

# Optional authenticated query cache. Dedicated key; never reuse session/connector/erasure keys.
# Enabling requires the independent worker and its QUERY_CACHE maintenance capability.
DASHBOARD_QUERY_CACHE_ENABLED=false
DASHBOARD_QUERY_CACHE_KEY=
DASHBOARD_QUERY_CACHE_TTL_SECONDS=300
DASHBOARD_QUERY_CACHE_MAX_ENTRIES=32

# Independent Dashboard email/password authentication. Email service is used only for
# verification and account recovery; user records remain in DASHBOARD_DATABASE_URL.
# Obtain a sending domain and API key for this Dashboard application.
# DASHBOARD_PUBLIC_URL=https://dashboard.example.com
# DASHBOARD_PUBLIC_ORIGIN=https://dashboard.example.com
# DASHBOARD_EMAIL_API_KEY=
# DASHBOARD_EMAIL_FROM=Averidi Dashboard <accounts@dashboard.example.com>
