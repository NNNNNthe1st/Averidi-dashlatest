  workspace        DashboardWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataset          DashboardDataset        @relation(fields: [datasetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version          DashboardDatasetVersion @relation(fields: [versionId, datasetId], references: [id, datasetId], onDelete: Cascade)
  views            DashboardView[]

  @@unique([versionId, semanticRevision, engineVersion])
  @@unique([id, datasetId, workspaceId])
  @@index([workspaceId, datasetId, createdAt])
}

model DashboardConnectorOAuthAttempt {
