 entityKind String?
 entityId String?
 observedAt DateTime @default(now())
 eligibleAfter DateTime
 deletedAt DateTime?
 attempts Int @default(0)
 lastErrorCode String?
 @@unique([workspaceId,storageKey])
 @@index([workspaceId,status,eligibleAfter])
}
model DashboardStorageMaintenance {
 id String @id
 ownerToken String
 expiresAt DateTime
 startedAt DateTime @default(now())
}

model DashboardBillingBinding {
