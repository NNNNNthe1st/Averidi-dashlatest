}
model DashboardStorageDeletion {
 id String @id @default(cuid())
 workspaceId String
 workspace DashboardWorkspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 storageKey String
 fingerprint String
 fileSize BigInt
 reason String
