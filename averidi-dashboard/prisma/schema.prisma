  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}

model DashboardSupportCase {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   DashboardWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requesterId String
  requester   DashboardUser      @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  subject     String
  status      String             @default("OPEN")
  details     Json
  updatedAt   DateTime           @updatedAt
  createdAt   DateTime           @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId, status, updatedAt])
}

model DashboardConfiguration {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model DashboardAnalysisRun {
