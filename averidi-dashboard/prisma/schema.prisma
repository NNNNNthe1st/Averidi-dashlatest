  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}
model DashboardTeamMember {
  id String @id @default(cuid())
  workspaceId String
  teamId String
  userId String
  team DashboardTeam @relation(fields: [teamId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
