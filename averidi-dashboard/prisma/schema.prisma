 receiptHash String
 decision Json
 status String @default("PENDING")
 leaseToken String?
 leaseExpiresAt DateTime?
 availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
 attempts Int @default(0)
 deletedObjects Int @default(0)
 errorCode String?
 completedAt DateTime?
 createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
 updatedAt DateTime @updatedAt
 @@index([status,availableAt,leaseExpiresAt])
 @@index([userId])
}

model DashboardSourceMonitoringPolicy {
  id String @id @default(cuid())
  workspaceId String
  sourceId String
  maxAgeMinutes Int?
  notifyFailures Boolean @default(true)
  notifyMetricFailures Boolean @default(true)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace DashboardWorkspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  source DashboardDataSource @relation(fields:[sourceId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  @@unique([sourceId,workspaceId])
}

model DashboardSourceIncident {
  id String @id @default(cuid())
  workspaceId String
  sourceId String
  kind String
  status String @default("OPEN")
  code String
  generation Int @default(1)
  occurredAt DateTime @default(now())
  observedAt DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt DateTime?
  workspace DashboardWorkspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  source DashboardDataSource @relation(fields:[sourceId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  @@unique([sourceId,workspaceId,kind])
  @@index([workspaceId,status,occurredAt])
}

// Anonymous, bounded operational aggregates. Never source values or identity records.
model DashboardObservationBucket {
  window DateTime
  kind String
  name String
  outcome String
  count Int @default(0)
  totalMs Float @default(0)
  maxMs Float @default(0)
  @@id([window,kind,name,outcome])
  @@index([kind,window])
}


model DashboardCredentialToken {
 id String @id @default(cuid())
 userId String
 kind String
 tokenHash String @unique
 expiresAt DateTime
 consumedAt DateTime?
 createdAt DateTime @default(now())
 user DashboardUser @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,kind,expiresAt])
}
