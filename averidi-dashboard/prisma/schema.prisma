  organizationId String
  organization DashboardOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorIssuer String
  actorSubject String
  action String
  resourceId String
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

// Short-lived network budget counters. Never stores raw addresses, tokens, users or request bodies.
model DashboardRequestBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@index([expiresAt])
}

model DashboardCheckoutAttempt {
  id                String   @id @default(uuid())
  workspaceId       String
  workspace         DashboardWorkspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  planId            String
  plan              DashboardBillingPlan @relation(fields:[planId], references:[id], onDelete:Restrict)
  activeKey         String?
  status            String   @default("CREATING")
  externalSessionId String?  @unique
  request           Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime
  @@unique([workspaceId, activeKey])
  @@index([workspaceId, createdAt])
}

// Independent mutation evidence survives resource deletion; no cascading tenant/user FK.
model DashboardMutationAudit {
 id String @id @default(cuid())
 workspaceId String?
 organizationId String?
 userId String?
 actorUserId String?
 actorIssuer String
 actorSubject String
 actorSource String
 transactionId String
 resourceType String
 resourceId String
 operation String
 action String?
 changedFields String[]
 createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
 @@index([workspaceId,createdAt,id])
 @@index([organizationId,createdAt,id])
 @@index([userId,createdAt,id])
 @@index([transactionId])
 @@index([createdAt,id])
}


model DashboardQueryCache {
 id String @id
 workspaceId String
 viewId String
 scopeHash String
 payload String
 signature String
 createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
 expiresAt DateTime
 workspace DashboardWorkspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 view DashboardView @relation(fields:[viewId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 @@index([workspaceId,viewId,scopeHash])
 @@index([expiresAt])
 @@index([createdAt])
}

model DashboardAccountErasure {
 id String @id @default(uuid())
