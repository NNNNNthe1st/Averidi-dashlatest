# Install on an independent host and place TLS ingress before the loopback listener.
DASHBOARD_WATCHDOG_PORT=9468
DASHBOARD_WATCHDOG_TIMEOUT_SECONDS=120
DASHBOARD_WATCHDOG_STATE_DIRECTORY=/var/lib/averidi-dashboard-watchdog
DASHBOARD_MONITOR_HEARTBEAT_TOKEN=
# Required authenticated alert receiver; separate from the monitored application.
DASHBOARD_MONITOR_WEBHOOK_URL=
DASHBOARD_MONITOR_WEBHOOK_TOKEN=
# Shared validated monitoring configuration; the watchdog does not call the app.
DASHBOARD_MONITOR_READY_URL=https://dashboard-staging.example.invalid/dashboard/app/api/health/ready
